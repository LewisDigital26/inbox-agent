# Copy this file to .env and fill in your own values. Never upload .env anywhere.

# Google AI Studio (free tier): https://aistudio.google.com
GEMINI_API_KEY=

# Gmail account the agent reads and replies from (use an app password, not your real password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Google Sheet + Apps Script web app (the secret must match the one in the script)
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
SHEET_URL=

# Telegram bot from @BotFather, and your own chat ID (run agent.py once to find it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety list: replies and invites can ONLY go to these addresses (comma separated)
SEND_ONLY_TO=
